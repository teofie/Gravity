{
  "schemaVersion": 1,
  "id": "gravitymod",
  "version": "${version}",
  "name": "Gravity",
  "icon": "assets/gravitymod/icon.png",
  "description": "/gravity [value] to configure gravity for players, mobs and dropped items.",
  "authors": [
    "teofie"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.gravitymod.GravityMod"
    ],
    "client": [
      "com.example.gravitymod.GravityClient"
    ]
  },
  "mixins": [
    "gravitymod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
